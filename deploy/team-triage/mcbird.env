# Non-secret service configuration for the OpenClaw Team mentions deployment
# (https://mcbird.openclaw.ai). Installed to /etc/birdclaw-team/team-triage.env
# by install-release.sh. Secrets never go in this file: the xAI key is written
# to /etc/birdclaw-team/secrets.env from AWS SSM Parameter Store at deploy time.
BIRDCLAW_HOME=/var/lib/birdclaw-team/mentions
BIRDCLAW_TRIAGE_AUTH_HOME=/var/lib/birdclaw-team/auth
BIRDCLAW_TRIAGE_PROXY_TOKEN_FILE=/etc/birdclaw-team/proxy-token
BIRDCLAW_TRIAGE_PUBLIC_ORIGIN=https://mcbird.openclaw.ai
BIRDCLAW_TRIAGE_TEAM_ORIGIN=https://team.openclaw.ai
BIRDCLAW_PORT=4317
BIRDCLAW_TRIAGE_ALLOW_HANDOFF=0
BIRDCLAW_TRIAGE_SOURCE=grok
BIRDCLAW_TRIAGE_SYNC_ACCOUNT=team-triage
BIRDCLAW_NODE_BIN=/opt/node/bin/node
